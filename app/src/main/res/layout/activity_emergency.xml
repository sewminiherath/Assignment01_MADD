        <!-- Back button -->
        <ImageView
            android:id="@+id/back_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="25dp"
            android:layout_marginTop="54dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back button"
            android:clickable="true"
            android:focusable="true" />

        <!-- Emergency contacts title -->
        <TextView
            android:id="@+id/emergency_contacts_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginTop="80dp"
            android:text="@string/your_emergency_contacts"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- First emergency contact input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emergency_contact1_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:layout_marginTop="16dp"
            android:layout_below="@+id/emergency_contacts_title"
            android:hint="@string/emergency_contact_1"
            app:hintTextColor="@android:color/white"
            app:boxStrokeColor="@android:color/white"
            app:boxBackgroundColor="@color/background_dark"
            app:boxCornerRadiusTopStart="6dp"
            app:boxCornerRadiusTopEnd="6dp"
            app:boxCornerRadiusBottomStart="6dp"
            app:boxCornerRadiusBottomEnd="6dp"
            app:boxStrokeWidth="1dp"
            app:startIconDrawable="@drawable/ic_person"
            app:startIconTint="@android:color/white"
            app:boxCollapsedPaddingTop="8dp"
            app:boxStrokeWidthFocused="2dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emergency_contact1_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:textColor="@android:color/white"
                android:textColorHint="@android:color/white"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:textSize="16sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Emergency Contact 1 Phone Number -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emergency_phone1_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:layout_marginTop="12dp"
            android:layout_below="@+id/emergency_contact1_layout"
            android:hint="@string/emergency_contact_1_phone"
            app:hintTextColor="@android:color/white"
            app:boxStrokeColor="@android:color/white"
            app:boxBackgroundColor="@color/background_dark"
            app:boxCornerRadiusTopStart="6dp"
            app:boxCornerRadiusTopEnd="6dp"
            app:boxCornerRadiusBottomStart="6dp"
            app:boxCornerRadiusBottomEnd="6dp"
            app:boxStrokeWidth="1dp"
            app:startIconDrawable="@android:drawable/stat_sys_phone_call"
            app:startIconTint="@android:color/white"
            app:boxCollapsedPaddingTop="8dp"
            app:boxStrokeWidthFocused="2dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emergency_phone1_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:textColor="@android:color/white"
                android:textColorHint="@android:color/white"
                android:inputType="phone"
                android:maxLines="1"
                android:textSize="16sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Second emergency contact input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emergency_contact2_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:layout_marginTop="12dp"
            android:layout_below="@+id/emergency_phone1_layout"
            android:hint="@string/emergency_contact_2"
            app:hintTextColor="@android:color/white"
            app:boxStrokeColor="@android:color/white"
            app:boxBackgroundColor="@color/background_dark"
            app:boxCornerRadiusTopStart="6dp"
            app:boxCornerRadiusTopEnd="6dp"
            app:boxCornerRadiusBottomStart="6dp"
            app:boxCornerRadiusBottomEnd="6dp"
            app:boxStrokeWidth="1dp"
            app:startIconDrawable="@drawable/ic_person"
            app:startIconTint="@android:color/white"
            app:boxCollapsedPaddingTop="8dp"
            app:boxStrokeWidthFocused="2dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emergency_contact2_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:textColor="@android:color/white"
                android:textColorHint="@android:color/white"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:textSize="16sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Emergency Contact 2 Phone Number -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emergency_phone2_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:layout_marginTop="12dp"
            android:layout_below="@+id/emergency_contact2_layout"
            android:hint="@string/emergency_contact_2_phone"
            app:hintTextColor="@android:color/white"
            app:boxStrokeColor="@android:color/white"
            app:boxBackgroundColor="@color/background_dark"
            app:boxCornerRadiusTopStart="6dp"
            app:boxCornerRadiusTopEnd="6dp"
            app:boxCornerRadiusBottomStart="6dp"
            app:boxCornerRadiusBottomEnd="6dp"
            app:boxStrokeWidth="1dp"
            app:startIconDrawable="@android:drawable/stat_sys_phone_call"
            app:startIconTint="@android:color/white"
            app:boxCollapsedPaddingTop="8dp"
            app:boxStrokeWidthFocused="2dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emergency_phone2_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:textColor="@android:color/white"
                android:textColorHint="@android:color/white"
                android:inputType="phone"
                android:maxLines="1"
                android:textSize="16sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Save Emergency Contacts Button -->
        <Button
            android:id="@+id/save_emergency_contacts_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:layout_marginTop="40dp"
            android:layout_below="@+id/emergency_phone2_layout"
            android:layout_centerInParent="true"
            android:backgroundTint="@color/orange"
            android:text="@string/save_emergency_contacts"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:elevation="4dp"
            style="@style/Widget.Material3.Button" />

        <!-- Emergency services title -->
        <TextView
            android:id="@+id/emergency_services_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_below="@+id/save_emergency_contacts_button"
            android:layout_marginTop="60dp"
            android:text="@string/emergency_services"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Police card -->
        <RelativeLayout
            android:id="@+id/police_card"
            android:layout_width="160dp"
            android:layout_height="140dp"
            android:layout_marginStart="25dp"
            android:layout_below="@+id/emergency_services_title"
            android:layout_marginTop="16dp"
            android:background="@drawable/emergency_card_background"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp">

            <TextView
                android:id="@+id/police_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="16dp"
                android:text="@string/police"
                android:textColor="#FFA6A1A1"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/police_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="50dp"
                android:contentDescription="Police icon"
                android:src="@drawable/police" />

            <TextView
                android:id="@+id/police_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="100dp"
                android:text="119"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Fire card -->
        <RelativeLayout
            android:id="@+id/fire_card"
            android:layout_width="160dp"
            android:layout_height="140dp"
            android:layout_marginStart="200dp"
            android:layout_below="@+id/emergency_services_title"
            android:layout_marginTop="16dp"
            android:background="@drawable/emergency_card_background"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp">

            <TextView
                android:id="@+id/fire_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="16dp"
                android:text="@string/fire"
                android:textColor="#FFA6A1A1"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/fire_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="50dp"
                android:contentDescription="Fire icon"
                android:src="@drawable/fire" />

            <TextView
                android:id="@+id/fire_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="100dp"
                android:text="110"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Ambulance card -->
        <RelativeLayout
            android:id="@+id/ambulance_card"
            android:layout_width="160dp"
            android:layout_height="140dp"
            android:layout_marginStart="25dp"
            android:layout_below="@+id/police_card"
            android:layout_marginTop="12dp"
            android:background="@drawable/emergency_card_background"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp">

            <TextView
                android:id="@+id/ambulance_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="16dp"
                android:text="@string/ambulance"
                android:textColor="#FFA6A1A1"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/ambulance_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="50dp"
                android:contentDescription="Ambulance icon"
                android:src="@drawable/ambulance" />

            <TextView
                android:id="@+id/ambulance_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="100dp"
                android:text="1990"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Customer care card -->
        <RelativeLayout
            android:id="@+id/customer_care_card"
            android:layout_width="160dp"
            android:layout_height="140dp"
            android:layout_marginStart="200dp"
            android:layout_below="@+id/fire_card"
            android:layout_marginTop="12dp"
            android:background="@drawable/emergency_card_background"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp">

            <TextView
                android:id="@+id/customer_care_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="16dp"
                android:text="@string/customer_care"
                android:textColor="#FFA6A1A1"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/ambulance_icon2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="50dp"
                android:contentDescription="Customer care icon"
                android:src="@drawable/customercare" />

            <TextView
                android:id="@+id/customer_care_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="100dp"
                android:text="1331"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </RelativeLayout>

    </RelativeLayout>

</ScrollView>