<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark_blue">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="25dp"
            android:paddingTop="20dp"
            android:gravity="center_vertical">

            <!-- Back Arrow -->
            <ImageView
                android:id="@+id/back_arrow"
                android:layout_width="30dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_back_arrow"
                android:rotation="-90" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- My Trip Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Trip"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- Duration Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="25dp"
            android:paddingTop="20dp"
            android:gravity="center_vertical">

            <!-- 1 Day -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 Day"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Duration Label -->
<!--            <TextView-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:text="Duration"-->
<!--                android:textColor="@color/light_gray"-->
<!--                android:textSize="14sp"-->
<!--                android:layout_marginTop="20dp" />-->

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Calendar Icon -->
            <ImageView
                android:id="@+id/calendar_icon"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/ic_calendar"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp" />

            <!-- Date Input Field -->
            <TextView
                android:id="@+id/date_input_field"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Day 01"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp" />

        </LinearLayout>

        <!-- Day Selector with Dropdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="25dp"
            android:paddingTop="15dp">

            <!-- Day 01 Main Selector -->
            <LinearLayout
                android:id="@+id/day_selector_main"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="@drawable/day_selector_background_white"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true">

                <!-- Day 01 Text -->
                <TextView
                    android:id="@+id/date_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Day 01"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Dropdown Icon -->
                <ImageView
                    android:id="@+id/dropdown_icon"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_dropdown" />

            </LinearLayout>

            <!-- Dropdown Menu (Initially Hidden) -->
            <LinearLayout
                android:id="@+id/dropdown_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/dropdown_background"
                android:visibility="gone"
                android:layout_marginTop="2dp">

                <!-- Day 02 -->
                <LinearLayout
                    android:id="@+id/day_02_item"
                    android:layout_width="match_parent"
                    android:layout_height="19dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Day 02"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Day 03 -->
                <LinearLayout
                    android:id="@+id/day_03_item"
                    android:layout_width="match_parent"
                    android:layout_height="19dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Day 03"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Day 04 -->
                <LinearLayout
                    android:id="@+id/day_04_item"
                    android:layout_width="match_parent"
                    android:layout_height="19dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Day 04"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Timeline Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="25dp"
            android:paddingTop="20dp">

            <!-- Timeline Item 1: Destination 01 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <!-- Timeline Dot -->
                <View
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/timeline_dot_white"
                    android:layout_marginTop="5dp" />

                <!-- Timeline Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <!-- Location Name -->
                    <TextView
                        android:id="@+id/destination_01_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination 01"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Time Input -->
                    <EditText
                        android:id="@+id/time_input_01"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="09:00am"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:maxLines="1"
                        android:enabled="false"
                        android:focusable="false" />

                </LinearLayout>

                <!-- Clock Icon on the Right -->
                <ImageView
                    android:id="@+id/clock_icon_01"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/clock" />

            </LinearLayout>

            <!-- Timeline Line -->
            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:background="@android:color/white"
                android:layout_marginStart="37dp" />

            <!-- Timeline Item 2: Destination 02 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <!-- Timeline Dot -->
                <View
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/timeline_dot_white"
                    android:layout_marginTop="5dp" />

                <!-- Timeline Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <!-- Location Name -->
                    <TextView
                        android:id="@+id/destination_02_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination 02"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Time Input -->
                    <EditText
                        android:id="@+id/time_input_02"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10:30am"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:maxLines="1"
                        android:enabled="false"
                        android:focusable="false" />

                </LinearLayout>

                <!-- Clock Icon on the Right -->
                <ImageView
                    android:id="@+id/clock_icon_02"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/clock" />

            </LinearLayout>

            <!-- Timeline Line -->
            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:background="@android:color/white"
                android:layout_marginStart="37dp" />

            <!-- Timeline Item 3: Destination 03 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <!-- Timeline Dot -->
                <View
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/timeline_dot_white"
                    android:layout_marginTop="5dp" />

                <!-- Timeline Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <!-- Location Name -->
                    <TextView
                        android:id="@+id/destination_03_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination 03"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Time Input -->
                    <EditText
                        android:id="@+id/time_input_03"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:00pm"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:maxLines="1"
                        android:enabled="false"
                        android:focusable="false" />

                </LinearLayout>

                <!-- Clock Icon on the Right -->
                <ImageView
                    android:id="@+id/clock_icon_03"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/clock" />

            </LinearLayout>

            <!-- Timeline Line -->
            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:background="@android:color/white"
                android:layout_marginStart="37dp" />

            <!-- Timeline Item 4: Destination 04 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <!-- Timeline Dot -->
                <View
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/timeline_dot_white"
                    android:layout_marginTop="5dp" />

                <!-- Timeline Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <!-- Location Name -->
                    <TextView
                        android:id="@+id/destination_04_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination 04"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Time Input -->
                    <EditText
                        android:id="@+id/time_input_04"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="02:30pm"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:maxLines="1"
                        android:enabled="false"
                        android:focusable="false" />

                </LinearLayout>

                <!-- Clock Icon on the Right -->
                <ImageView
                    android:id="@+id/clock_icon_04"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/clock" />

            </LinearLayout>

            <!-- Timeline Line -->
            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:background="@android:color/white"
                android:layout_marginStart="37dp" />

            <!-- Timeline Item 5: Destination 05 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <!-- Timeline Dot -->
                <View
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/timeline_dot_white"
                    android:layout_marginTop="5dp" />

                <!-- Timeline Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <!-- Location Name -->
                    <TextView
                        android:id="@+id/destination_05_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination 05"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Time Input -->
                    <EditText
                        android:id="@+id/time_input_05"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="04:00pm"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:maxLines="1"
                        android:enabled="false"
                        android:focusable="false" />

                </LinearLayout>

                <!-- Clock Icon on the Right -->
                <ImageView
                    android:id="@+id/clock_icon_05"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/clock" />

            </LinearLayout>

            <!-- Timeline Line -->
            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:background="@android:color/white"
                android:layout_marginStart="37dp" />

            <!-- Timeline Item 6: Destination 06 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <!-- Timeline Dot -->
                <View
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/timeline_dot_white"
                    android:layout_marginTop="5dp" />

                <!-- Timeline Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <!-- Location Name -->
                    <TextView
                        android:id="@+id/destination_06_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination 06"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Time Input -->
                    <EditText
                        android:id="@+id/time_input_06"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="05:30pm"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:maxLines="1"
                        android:enabled="false"
                        android:focusable="false" />

                </LinearLayout>

                <!-- Clock Icon on the Right -->
                <ImageView
                    android:id="@+id/clock_icon_06"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/clock" />

            </LinearLayout>

        </LinearLayout>

        <!-- Check Out Button -->
        <LinearLayout
            android:id="@+id/check_out_button"
            android:layout_width="165dp"
            android:layout_height="43dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="25dp"
            android:layout_gravity="end"
            android:background="@drawable/check_out_button"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Check Out"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
