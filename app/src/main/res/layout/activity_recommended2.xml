<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark_blue">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- Recommended Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginTop="20dp"
            android:text="Recommended"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Pagination Dots (Page 2 - different order) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <!-- Inactive Dot -->
            <View
                android:id="@+id/dot_inactive"
                android:layout_width="12dp"
                android:layout_height="14dp"
                android:background="@drawable/dot_inactive"
                android:layout_marginEnd="5dp" />

            <!-- Active Dot -->
            <View
                android:id="@+id/dot_active"
                android:layout_width="12dp"
                android:layout_height="14dp"
                android:background="@drawable/dot_active" />

        </LinearLayout>

        <!-- Destination Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="vertical"
            android:paddingHorizontal="25dp">

            <!-- First Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <RelativeLayout
                    android:id="@+id/destination1_card"
                    android:layout_width="0dp"
                    android:layout_height="207dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/destination1_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:adjustViewBounds="true"
                        android:contentDescription="Destination 1"
                        android:scaleType="centerInside"
                        android:src="@drawable/polonnaruwa" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/destination2_card"
                    android:layout_width="0dp"
                    android:layout_height="207dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/destination2_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:adjustViewBounds="true"
                        android:contentDescription="Destination 2"
                        android:scaleType="centerInside"
                        android:src="@drawable/yapahuwa" />

                </RelativeLayout>

            </LinearLayout>

            <!-- Second Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <RelativeLayout
                    android:id="@+id/destination3_card"
                    android:layout_width="0dp"
                    android:layout_height="207dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/destination3_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:adjustViewBounds="true"
                        android:contentDescription="Destination 3"
                        android:scaleType="centerInside"
                        android:src="@drawable/nallur" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/destination4_card"
                    android:layout_width="0dp"
                    android:layout_height="207dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/destination4_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:adjustViewBounds="true"
                        android:contentDescription="Destination 4"
                        android:scaleType="centerInside"
                        android:src="@drawable/beach" />

                </RelativeLayout>

            </LinearLayout>

            <!-- Third Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <RelativeLayout
                    android:id="@+id/destination5_card"
                    android:layout_width="0dp"
                    android:layout_height="207dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/destination5_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:adjustViewBounds="true"
                        android:contentDescription="Destination 5"
                        android:scaleType="centerInside"
                        android:src="@drawable/sinharaja" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/destination6_card"
                    android:layout_width="0dp"
                    android:layout_height="207dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/destination6_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:adjustViewBounds="true"
                        android:contentDescription="Destination 6"
                        android:scaleType="centerInside"
                        android:src="@drawable/waterfall" />

                </RelativeLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Bottom Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="53dp"
            android:layout_marginTop="15dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bottom_navigation_background"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Location Icon (Active) -->
            <ImageView
                android:id="@+id/nav_location"
                android:layout_width="37dp"
                android:layout_height="37dp"
                android:layout_marginHorizontal="20dp"
                android:src="@drawable/ic_location" />

            <!-- Home Icon -->
            <ImageView
                android:id="@+id/nav_home"
                android:layout_width="37dp"
                android:layout_height="37dp"
                android:src="@drawable/ic_home"
                android:layout_marginHorizontal="20dp" />

            <!-- Notifications Icon -->
            <ImageView
                android:id="@+id/nav_notifications"
                android:layout_width="37dp"
                android:layout_height="37dp"
                android:src="@drawable/ic_bell"
                android:layout_marginHorizontal="20dp" />

            <!-- Profile Icon -->
            <ImageView
                android:id="@+id/nav_profile"
                android:layout_width="37dp"
                android:layout_height="37dp"
                android:layout_marginHorizontal="20dp"
                android:src="@drawable/ic_person" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
