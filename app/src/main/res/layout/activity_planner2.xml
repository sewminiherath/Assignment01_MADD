<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark_blue"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="25dp"
            android:paddingTop="20dp"
            android:gravity="center_vertical">

            <!-- Back Arrow -->
            <ImageView
                android:id="@+id/back_arrow"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/back_button_description"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- My Trip Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_trip"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Date -->
            <TextView
                android:id="@+id/date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05th September,2025"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Calendar Icon -->
            <ImageView
                android:id="@+id/calendar_icon"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/ic_calendar"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/calendar_icon"
                android:clickable="true"
                android:focusable="true" />

            <!-- Clock Icon -->
            <ImageView
                android:id="@+id/clock_icon"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/ic_clock"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/clock_icon"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Duration Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="10dp"
            android:paddingHorizontal="25dp"
            android:paddingTop="20dp"
            android:gravity="center_vertical">

            <!-- 1 Day -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/one_day"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

<!--            &lt;!&ndash; Duration Label &ndash;&gt;-->
<!--            <TextView-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:text="Duration"-->
<!--                android:layout_marginStart="1dp"-->
<!--                android:textColor="@color/light_gray"-->
<!--                android:textSize="14sp"-->
<!--                android:layout_marginTop="20dp" />-->

        </LinearLayout>

        <!-- Day Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginHorizontal="25dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/day_selector_background_white"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <!-- Day 01 Text -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_01"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Dropdown Icon -->
            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_dropdown"
                android:contentDescription="@string/dropdown_icon" />

        </LinearLayout>

        <!-- Timeline Container -->
        <LinearLayout
            android:id="@+id/timeline_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="25dp"
            android:paddingTop="20dp">

            <!-- Timeline Item 1: Ruwanweli Maha Seya -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <!-- Timeline Dot -->
                <View
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/timeline_dot_white"
                    android:layout_marginTop="5dp" />

                <!-- Timeline Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <!-- Location Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ruwanweli Maha Seya"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Time Input -->
                    <EditText
                        android:id="@+id/time_input_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="05:30am"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:maxLines="1"
                        android:enabled="false"
                        android:focusable="false" />

                    <!-- Image -->
                    <ImageView
                        android:layout_width="59dp"
                        android:layout_height="81dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/image_border_white"
                        android:scaleType="centerCrop"
                        android:src="@drawable/mhaseya"
                        android:contentDescription="@string/destination_01" />

                </LinearLayout>

                <!-- Clock Icon for Time Selection -->
                <ImageView
                    android:id="@+id/clock_icon_1"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="16dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_clock"
                    android:contentDescription="@string/clock_icon"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp" />

            </LinearLayout>

            <!-- Timeline Line -->
            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:background="@android:color/white"
                android:layout_marginStart="37dp" />

            <!-- Timeline Item 2: Jaya Sri Maha Bodhiya -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <!-- Timeline Dot -->
                <View
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/timeline_dot_white"
                    android:layout_marginTop="5dp" />

                <!-- Timeline Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <!-- Location Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jaya Sri Maha Bodhiya"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Time Input -->
                    <EditText
                        android:id="@+id/time_input_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="06:30am"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:maxLines="1"
                        android:enabled="false"
                        android:focusable="false" />

                    <!-- Image -->
                    <ImageView
                        android:layout_width="59dp"
                        android:layout_height="81dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/image_border_white"
                        android:scaleType="centerCrop"
                        android:src="@drawable/srimahabodhiya" />

                </LinearLayout>

                <!-- Clock Icon for Time Selection -->
                <ImageView
                    android:id="@+id/clock_icon_2"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="16dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_clock"
                    android:contentDescription="@string/clock_icon"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp" />

            </LinearLayout>

            <!-- Timeline Line -->
            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:background="@android:color/white"
                android:layout_marginStart="37dp" />

            <!-- Timeline Item 3: Thuparamaya -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <!-- Timeline Dot -->
                <View
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/timeline_dot_white"
                    android:layout_marginTop="5dp" />

                <!-- Timeline Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <!-- Location Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thuparamaya"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Time Input -->
                    <EditText
                        android:id="@+id/time_input_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="07:30pm"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:maxLines="1"
                        android:enabled="false"
                        android:focusable="false" />

                    <!-- Image -->
                    <ImageView
                        android:layout_width="59dp"
                        android:layout_height="81dp"
                        android:src="@drawable/thuparamaya"
                        android:scaleType="centerCrop"
                        android:background="@drawable/image_border_white"
                        android:layout_marginTop="10dp" />

                </LinearLayout>

                <!-- Clock Icon for Time Selection -->
                <ImageView
                    android:id="@+id/clock_icon_3"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="16dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_clock"
                    android:contentDescription="@string/clock_icon"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp" />

            </LinearLayout>

            <!-- Timeline Line -->
            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:background="@android:color/white"
                android:layout_marginStart="37dp" />

            <!-- Timeline Item 4: Abhyagirya -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <!-- Timeline Dot -->
                <View
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/timeline_dot_white"
                    android:layout_marginTop="5dp" />

                <!-- Timeline Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <!-- Location Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Abhyagirya"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Time Input -->
                    <EditText
                        android:id="@+id/time_input_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="08:30pm"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:maxLines="1"
                        android:enabled="false"
                        android:focusable="false" />

                    <!-- Image -->
                    <ImageView
                        android:layout_width="59dp"
                        android:layout_height="81dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/image_border_white"
                        android:scaleType="centerCrop"
                        android:src="@drawable/abhayagiriya" />

                </LinearLayout>

                <!-- Clock Icon for Time Selection -->
                <ImageView
                    android:id="@+id/clock_icon_4"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="16dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_clock"
                    android:contentDescription="@string/clock_icon"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp" />

            </LinearLayout>

            <!-- Timeline Line -->
            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:background="@android:color/white"
                android:layout_marginStart="37dp" />

            <!-- Timeline Item 5: Isurumuniya -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <!-- Timeline Dot -->
                <View
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/timeline_dot_white"
                    android:layout_marginTop="5dp" />

                <!-- Timeline Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <!-- Location Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Isurumuniya"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Time Input -->
                    <EditText
                        android:id="@+id/time_input_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10:30pm"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:maxLines="1"
                        android:enabled="false"
                        android:focusable="false" />

                    <!-- Image -->
                    <ImageView
                        android:layout_width="59dp"
                        android:layout_height="81dp"
                        android:src="@drawable/isurumuniya"
                        android:scaleType="centerCrop"
                        android:background="@drawable/image_border_white"
                        android:layout_marginTop="10dp" />

                </LinearLayout>

                <!-- Clock Icon for Time Selection -->
                <ImageView
                    android:id="@+id/clock_icon_5"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="16dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_clock"
                    android:contentDescription="@string/clock_icon"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp" />

            </LinearLayout>

            <!-- Timeline Line -->
            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:background="@android:color/white"
                android:layout_marginStart="37dp" />

            <!-- Timeline Item 6: Destination 06 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <!-- Timeline Dot -->
                <View
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/timeline_dot_white"
                    android:layout_marginTop="5dp" />

                <!-- Timeline Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <!-- Location Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/destination_06"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Alarm Clock Icon -->

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Share Plan Button -->
        <LinearLayout
            android:id="@+id/share_plan_button"
            android:layout_width="165dp"
            android:layout_height="43dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="25dp"
            android:layout_gravity="end"
            android:background="@drawable/share_plan_button_orange"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share Plan"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
