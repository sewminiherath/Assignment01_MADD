<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".LocationDetailActivity">


    <!-- Hero Image -->
    <ImageView
        android:id="@+id/locationImage"
        android:layout_width="0dp"
        android:layout_height="500dp"
        android:scaleType="centerCrop"
        android:src="@drawable/anuradhapura_sacred_city_detailed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Information Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/infoCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:layout_marginTop="469dp"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="50dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Location Name -->
                <TextView
                    android:id="@+id/locationName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anuradhapura Sacred City"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Location Address with Pin Icon -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_location_pin"
                        app:tint="@color/black" />

                    <TextView
                        android:id="@+id/locationAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Anuradhapura City"
                        android:textColor="@color/black"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Rating Stars -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_star"
                        app:tint="@color/yellow" />

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_star"
                        app:tint="@color/yellow" />

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_star"
                        app:tint="@color/yellow" />

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_star"
                        app:tint="@color/yellow" />

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_star"
                        app:tint="@color/yellow" />

                </LinearLayout>

                <!-- Nearby Restaurants Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/nearby_restaurants"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Restaurant Cards -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <!-- Golden Mango Restaurant Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="149dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="15dp"
                        app:cardElevation="4dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/hotel_yapahuwa_paradise" />

                    </androidx.cardview.widget.CardView>

                    <!-- Casserole Restaurant Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="149dp"
                        android:layout_height="100dp"
                        app:cardCornerRadius="15dp"
                        app:cardElevation="4dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/caffe_dew_ella" />

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- Restaurant Names and Ratings -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Golden Mango Restaurant Info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hotel Yapahuwa Paradise"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="11dp"
                                android:layout_height="10dp"
                                android:src="@drawable/ic_star"
                                app:tint="@color/yellow" />

                            <ImageView
                                android:layout_width="11dp"
                                android:layout_height="10dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/ic_star"
                                app:tint="@color/yellow" />

                            <ImageView
                                android:layout_width="11dp"
                                android:layout_height="10dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/ic_star"
                                app:tint="@color/yellow" />

                            <ImageView
                                android:layout_width="11dp"
                                android:layout_height="10dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/ic_star"
                                app:tint="@color/yellow" />

                            <ImageView
                                android:layout_width="11dp"
                                android:layout_height="10dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/ic_star"
                                app:tint="@color/yellow" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="1K Reviews"
                                android:textColor="@color/black"
                                android:textSize="8sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Casserole Restaurant Info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Caffe Dew Ella"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="11dp"
                                android:layout_height="10dp"
                                android:src="@drawable/ic_star"
                                app:tint="@color/yellow" />

                            <ImageView
                                android:layout_width="11dp"
                                android:layout_height="10dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/ic_star"
                                app:tint="@color/yellow" />

                            <ImageView
                                android:layout_width="11dp"
                                android:layout_height="10dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/ic_star"
                                app:tint="@color/yellow" />

                            <ImageView
                                android:layout_width="11dp"
                                android:layout_height="10dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/ic_star"
                                app:tint="@color/yellow" />

                            <ImageView
                                android:layout_width="11dp"
                                android:layout_height="10dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/ic_star"
                                app:tint="@color/yellow" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="1.1K Reviews"
                                android:textColor="@color/black"
                                android:textSize="8sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Add to Planner Button -->
                <LinearLayout
                    android:id="@+id/addToPlannerButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/add_to_planner"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Location Navigation Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- Previous Button -->
                    <Button
                        android:id="@+id/btnPrevious"
                        android:layout_width="120dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="16dp"
                        android:text="← Previous"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:background="@drawable/button_orange_rounded"
                        android:elevation="2dp" />

                    <!-- Next Button -->
                    <Button
                        android:id="@+id/btnNext"
                        android:layout_width="120dp"
                        android:layout_height="40dp"
                        android:text="Next →"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:background="@drawable/button_orange_rounded"
                        android:elevation="2dp" />

                </LinearLayout>

                <!-- Scroll Indicators -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="30dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/indicator_active" />

                    <View
                        android:layout_width="30dp"
                        android:layout_height="12dp"
                        android:background="@drawable/indicator_inactive" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </androidx.cardview.widget.CardView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="53dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bottom_navigation_background"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Location Pin Icon -->
        <ImageView
            android:id="@+id/locationIcon"
            android:layout_width="37dp"
            android:layout_height="37dp"
            android:layout_weight="1"
            android:src="@drawable/ic_location_pin"
            android:tint="@color/black"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Home Icon -->
        <ImageView
            android:id="@+id/homeIcon"
            android:layout_width="37dp"
            android:layout_height="37dp"
            android:layout_weight="1"
            android:src="@drawable/ic_home"
            android:tint="@color/black"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Bell Icon -->
        <ImageView
            android:id="@+id/notificationsIcon"
            android:layout_width="37dp"
            android:layout_height="37dp"
            android:layout_weight="1"
            android:src="@drawable/ic_bell"
            android:tint="@color/black"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Profile Icon -->
        <ImageView
            android:id="@+id/profileIcon"
            android:layout_width="37dp"
            android:layout_height="37dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_person"
            android:tint="@color/black" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>