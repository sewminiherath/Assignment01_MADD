<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark_blue">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="25dp"
            android:paddingTop="20dp"
            android:gravity="center_vertical">

            <!-- Back Arrow -->
            <ImageView
                android:id="@+id/back_arrow"
                android:layout_width="30dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_back_arrow"
                android:rotation="-90" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- My Trip Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Trip"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- Duration Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="25dp"
            android:paddingTop="20dp"
            android:gravity="center_vertical">

            <!-- 1 Day -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 Day"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Duration Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Duration"
                android:textColor="@color/light_gray"
                android:textSize="14sp"
                android:layout_marginTop="20dp" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Calendar Icon -->
            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/ic_calendar" />

        </LinearLayout>

        <!-- Day Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginHorizontal="25dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/day_selector_background_white_with_border"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <!-- Day 01 Text -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Day 01"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Dropdown Icon -->
            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_dropdown" />

        </LinearLayout>

        <!-- Timeline Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="25dp"
            android:paddingTop="20dp">

            <!-- Timeline Item 1: Destination 01 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <!-- Timeline Dot -->
                <View
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/timeline_dot_white_with_border"
                    android:layout_marginTop="5dp" />

                <!-- Timeline Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <!-- Location Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination 01"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Alarm Clock Icon -->

                </LinearLayout>

            </LinearLayout>

            <!-- Timeline Line -->
            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:background="@android:color/white"
                android:layout_marginStart="37dp" />

            <!-- Timeline Item 2: Destination 02 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <!-- Timeline Dot -->
                <View
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/timeline_dot_white_with_border"
                    android:layout_marginTop="5dp" />

                <!-- Timeline Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <!-- Location Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination 02"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Alarm Clock Icon -->

                </LinearLayout>

            </LinearLayout>

            <!-- Timeline Line -->
            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:background="@android:color/white"
                android:layout_marginStart="37dp" />

            <!-- Timeline Item 3: Destination 03 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <!-- Timeline Dot -->
                <View
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/timeline_dot_white_with_border"
                    android:layout_marginTop="5dp" />

                <!-- Timeline Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <!-- Location Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination 03"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Alarm Clock Icon -->

                </LinearLayout>

            </LinearLayout>

            <!-- Timeline Line -->
            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:background="@android:color/white"
                android:layout_marginStart="37dp" />

            <!-- Timeline Item 4: Destination 04 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <!-- Timeline Dot -->
                <View
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/timeline_dot_white_with_border"
                    android:layout_marginTop="5dp" />

                <!-- Timeline Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <!-- Location Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination 04"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Alarm Clock Icon -->

                </LinearLayout>

            </LinearLayout>

            <!-- Timeline Line -->
            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:background="@android:color/white"
                android:layout_marginStart="37dp" />

            <!-- Timeline Item 5: Destination 05 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <!-- Timeline Dot -->
                <View
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/timeline_dot_white_with_border"
                    android:layout_marginTop="5dp" />

                <!-- Timeline Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <!-- Location Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination 05"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Alarm Clock Icon -->

                </LinearLayout>

            </LinearLayout>

            <!-- Timeline Line -->
            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:background="@android:color/white"
                android:layout_marginStart="37dp" />

            <!-- Timeline Item 6: Destination 06 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <!-- Timeline Dot -->
                <View
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/timeline_dot_white_with_border"
                    android:layout_marginTop="5dp" />

                <!-- Timeline Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <!-- Location Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination 06"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Alarm Clock Icon -->

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Check Out Button -->
        <LinearLayout
            android:id="@+id/check_out_button"
            android:layout_width="165dp"
            android:layout_height="43dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="25dp"
            android:layout_gravity="end"
            android:background="@drawable/check_out_button_orange"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Check Out"
                android:textColor="@color/background_dark_blue"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
